# Node.js backend - copy to backend/.env. Never commit .env.

# Port this backend listens on (the frontend expects 3000 by default)
PORT=3000

# FastAPI AI service base URL
AI_SERVICE_URL=http://localhost:8000

# Max wait for the AI service per request, in ms (chat runs an agent loop). Default 60000.
# AI_TIMEOUT_MS=60000

# Comma-separated browser origins allowed to call this backend
CORS_ORIGINS=http://localhost:5173
