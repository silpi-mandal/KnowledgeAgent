# KnowledgeAgent AI service - copy to .env and fill in. Never commit .env.
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4000

# --- LLM: any OpenAI-compatible API. Default example = Google Gemini (free tier) ---
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Groq alternative: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile

# --- Embeddings ---
# local  = free/offline (pip install -r requirements-local-embeddings.txt)
# openai = remote OpenAI-compatible endpoint (uses LLM_API_KEY / LLM_BASE_URL)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

STORAGE_DIR=storage
